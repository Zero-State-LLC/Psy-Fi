# PsyFi Environment Configuration
# Copy this file to .env and fill in the values

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=info
DEBUG=false

# Server Configuration
# The image command is one Uvicorn process. It does not read a worker count.
HOST=0.0.0.0
PORT=8000

# CORS Settings (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ABX-Core Settings
DEFAULT_SEED=1337
ENABLE_PROVENANCE=true
ENABLE_METRICS=true

# Preset Settings
PRESETS_PATH=psyfi_core/presets/substance_presets.json
ENABLE_SAFETY_CLAMP=true
DEFAULT_INTENSITY=1.0

# API Rate Limiting (optional)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60

# Security
SECRET_KEY=change-me-in-production
API_KEY_REQUIRED=false

# Monitoring (optional)
SENTRY_DSN=
ENABLE_TELEMETRY=false

# Database (if using persistent storage in future)
# DATABASE_URL=postgresql://user:password@localhost:5432/psyfi

# Image Reading. Leave unset locally and in CI so the route fails closed
# and opens no socket. Production names the vision model in Cloudflare config
# (an nvidia/ id, not pinned in this repo). The key is a Worker secret,
# passed into the container at start. Do not put a key in this file.
# NVIDIA_API_BASE overrides the integrate host when an AI Gateway URL is used.

# Redis (if using caching in future)
# REDIS_URL=redis://localhost:6379/0
