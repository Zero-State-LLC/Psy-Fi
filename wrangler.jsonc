{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "psy-fi",
  "main": "workers/psyfi/src/index.mjs",
  "compatibility_date": "2026-11-07",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "psy-fi.space",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "containers": [
    {
      "class_name": "PsyfiApi",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PSYFI_API",
        "class_name": "PsyfiApi"
      }
    ]
  },
  "exports": {
    "PsyfiApi": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
