              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Capabilities V1 Capabilities Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Capabilities",
        "tags": [
          "bench"
        ]
      }
    },
    "/v1/captures": {
