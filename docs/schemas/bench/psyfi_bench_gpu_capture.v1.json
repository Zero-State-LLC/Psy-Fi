{
  "$defs": {
    "CaptureStage": {
      "additionalProperties": false,
      "description": "One browser-side GPU stage: fixed tier, fixed snapshot, N frames.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "tier": {
          "title": "Tier",
          "type": "string"
        },
        "snapshot_key": {
          "title": "Snapshot Key",
          "type": "string"
        },
        "requested_frames": {
          "title": "Requested Frames",
          "type": "integer"
        },
        "warmup_frames": {
          "title": "Warmup Frames",
          "type": "integer"
        },
        "frames_ms": {
          "description": "Wall-clock rAF spacing per frame, warm-up excluded.",
          "items": {
            "type": "number"
          },
          "title": "Frames Ms",
          "type": "array"
        },
        "gpu_ms": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "GPU pass time per frame when timestamp-query is available.",
          "title": "Gpu Ms"
        },
        "draw_calls": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Draw Calls"
        },
        "triangles": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Triangles"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "number"
        },
        "js_heap_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Js Heap Bytes"
        },
        "thumbnail_png_base64": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "128x128 PNG of one presented frame for tier fidelity.",
          "title": "Thumbnail Png Base64"
        },
        "snapshot_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot Hash"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "id",
        "tier",
        "snapshot_key",
        "requested_frames",
        "warmup_frames",
        "frames_ms",
        "duration_ms"
      ],
      "title": "CaptureStage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Payload a browser runner posts or downloads. Scored in Python.",
  "properties": {
    "schema": {
      "default": "psyfi.bench.gpu_capture.v1",
      "title": "Schema",
      "type": "string"
    },
    "captured_at": {
      "title": "Captured At",
      "type": "string"
    },
    "manifest_id": {
      "title": "Manifest Id",
      "type": "string"
    },
    "manifest_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manifest Hash"
    },
    "measurement_class": {
      "default": "measured",
      "enum": [
        "measured",
        "synthetic",
        "replay"
      ],
      "title": "Measurement Class",
      "type": "string"
    },
    "browser": {
      "additionalProperties": true,
      "description": "user_agent, adapter {vendor, architecture, device, description}, dpr, viewport, features.",
      "title": "Browser",
      "type": "object"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/CaptureStage"
      },
      "title": "Stages",
      "type": "array"
    },
    "aborted": {
      "default": false,
      "title": "Aborted",
      "type": "boolean"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    }
  },
  "required": [
    "captured_at",
    "manifest_id",
    "stages"
  ],
  "title": "GpuCapture",
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#"
}
