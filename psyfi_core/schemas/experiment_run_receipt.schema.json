{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "engine_version": {
      "title": "Engine Version",
      "type": "string"
    },
    "experiment_id": {
      "title": "Experiment Id",
      "type": "string"
    },
    "input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "observable_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Observable Versions",
      "type": "object"
    },
    "observables": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "string"
          },
          {
            "items": {},
            "type": "array"
          }
        ]
      },
      "title": "Observables",
      "type": "object"
    },
    "output_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Output Hash",
      "type": "string"
    },
    "parameters": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "title": "Parameters",
      "type": "object"
    },
    "provenance": {
      "additionalProperties": true,
      "title": "Provenance",
      "type": "object"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "psyfi.experiment_run_receipt.v1",
      "default": "psyfi.experiment_run_receipt.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "steps": {
      "title": "Steps",
      "type": "integer"
    }
  },
  "required": [
    "experiment_id",
    "run_id",
    "seed",
    "parameters",
    "engine_version",
    "observable_versions",
    "input_hash",
    "output_hash",
    "steps",
    "observables",
    "provenance"
  ],
  "title": "ExperimentRunReceipt",
  "type": "object"
}
